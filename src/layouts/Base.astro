---
import '../styles/app.css';
import { pfad, datei } from '../lib/pfad';

interface Props {
  title: string;
  description?: string;
  schmal?: boolean;
}

const { title, description, schmal = false } = Astro.props as Props;
const istStart = title === 'Leitfaden';
const fullTitle = istStart ? 'Leitfaden — eigene Werkzeuge bauen' : `${title} — Leitfaden`;
const desc =
  description ??
  'Leitfaden fuer eigene kleine Web-Werkzeuge: was sich zu bauen lohnt, wie man es mit einer KI baut und wie man es veroeffentlicht.';
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#005538" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="https://design-system.gruene.at/assets/gruene-logo.svg" />
    <link rel="stylesheet" href="https://design-system.gruene.at/design-system.css" />
    <link rel="alternate" type="text/plain" href={datei('llms.txt')} title="Maschinenlesbare Uebersicht (llms.txt)" />
  </head>
  <body>
    <a class="gat-skiplink" href="#main">Zum Hauptinhalt springen</a>
    <header class="gat-header">
      <div class="gat-header__inner">
        <a class="gat-header__brand" href={pfad()}>
          <img class="gat-header__logo"
               src="https://design-system.gruene.at/assets/gruene-logo.svg"
               alt="Die Grünen" />
          <span class="gat-header__wordmark">Leitfaden</span>
        </a>
        <nav class="gat-header__nav" aria-label="Hauptnavigation">
          <ul class="gat-header__nav-list">
            <li><a href={pfad() + '#projekttypen'}>Was baue ich?</a></li>
            <li><a href={pfad() + '#kapitel'}>Kapitel</a></li>
            <li><a href={pfad('fuer-ki')}>Für die KI</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class={schmal ? 'lf-main lf-main--schmal' : 'lf-main'}>
      <slot />
    </main>
    <footer class="lf-footer">
      <p>
        Leitfaden für eigene Werkzeuge · Die Grünen ·
        <a href="https://github.com/GrueneAT/leitfaden">Quellcode und Issues auf GitHub</a>
      </p>
      <p>
        Maschinenlesbar: <a href={datei('llms.txt')}>llms.txt</a> ·
        Werkzeug-Verzeichnis: <a href="https://werkzeuge.gruene.at/">werkzeuge.gruene.at</a>
      </p>
    </footer>
  </body>
</html>
