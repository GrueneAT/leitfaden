---
import '../styles/app.css';
import { pfad, datei } from '../lib/pfad';

interface Props {
  title: string;
  description?: string;
  lang?: 'de' | 'en';
  schmal?: boolean;
}

const { title, description, lang = 'de', schmal = false } = Astro.props as Props;
const en = lang === 'en';
const fullTitle = title === 'Leitfaden' || title === 'Build your own tools'
  ? (en ? 'Build your own tools' : 'Eigene Werkzeuge bauen')
  : `${title} — ${en ? 'Build guide' : 'Leitfaden'}`;
const desc = description ?? (en
  ? 'Build small tools by chatting with an AI. One HTML file, runs on your laptop, your data stays there.'
  : 'Eigene kleine Werkzeuge im Gespräch mit einer KI bauen. Eine HTML-Datei, läuft am eigenen Laptop, die Daten bleiben dort.');

const nav = en
  ? [
      { href: pfad('en'), label: 'Start' },
      { href: pfad('guide'), label: 'Build guide' },
      { href: pfad(), label: 'Deutsch' },
    ]
  : [
      { href: pfad(), label: 'Start' },
      { href: pfad('guide'), label: 'Leitfaden für die KI' },
      { href: pfad('en'), label: 'English' },
    ];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1f4a6d" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="stylesheet" href="https://flomotlik.github.io/design-system/design-system.css" />
    <link rel="alternate" type="text/plain" href={datei('llms.txt')} title="llms.txt" />
  </head>
  <body>
    <a class="fm-skiplink" href="#main">{en ? 'Skip to content' : 'Zum Hauptinhalt springen'}</a>
    <header class="fm-header">
      <div class="fm-header__inner">
        <a class="fm-header__brand" href={en ? pfad('en') : pfad()}>
          <span class="fm-header__wordmark">{en ? 'Build your own tools' : 'Eigene Werkzeuge'}</span>
        </a>
        <nav class="fm-header__nav" aria-label={en ? 'Main navigation' : 'Hauptnavigation'}>
          <ul class="fm-header__nav-list">
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class={schmal ? 'lf-main lf-main--schmal' : 'lf-main'}>
      <slot />
    </main>
    <footer class="lf-footer">
      <p>
        <a href="https://github.com/flomotlik/ai-build-guide">{en ? 'Source and issues on GitHub' : 'Quellcode und Issues auf GitHub'}</a>
      </p>
      <p>
        <a href={datei('llms.txt')}>llms.txt</a> ·
        <a href={datei('llms-full.txt')}>llms-full.txt</a> ·
        <a href="https://flomotlik.github.io/design-system/">{en ? 'Design system' : 'Design-System'}</a>
      </p>
    </footer>
  </body>
</html>
