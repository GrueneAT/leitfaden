---
import { pfad } from '../lib/pfad';

interface Props {
  id: string;
  title: string;
  kurz: string;
  nummer: number;
  schwierigkeit: string;
}

const { id, title, kurz, nummer, schwierigkeit } = Astro.props as Props;
const tagKlasse =
  schwierigkeit === 'einfach' ? 'gat-tag--ok'
  : schwierigkeit === 'mittel' ? 'gat-tag--info'
  : 'gat-tag--warn';
---
<a class="lf-karte" href={pfad('kapitel', id)}>
  <span class="lf-karte__titel">{nummer}. {title}</span>
  <p class="lf-karte__kurz">{kurz}</p>
  <span class="lf-karte__meta">
    <span class={`gat-tag ${tagKlasse}`}>{schwierigkeit}</span>
  </span>
</a>
