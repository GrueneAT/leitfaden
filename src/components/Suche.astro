---
// Pagefind-Such-UI. Pagefind erzeugt das Modul erst nach `astro build` unter
// dist/pagefind/ — im Entwicklungsserver faellt die Box deshalb bewusst
// stumm aus, statt einen Fehler zu werfen.
interface Props { lang?: 'de' | 'en' }
const { lang = 'de' } = Astro.props as Props;
const en = lang === 'en';
const t = en
  ? { placeholder: 'Search the guide …', zero: 'No results for "[SEARCH_TERM]"',
      many: '[COUNT] results for "[SEARCH_TERM]"', one: '1 result for "[SEARCH_TERM]"',
      searching: 'Searching "[SEARCH_TERM]" …' }
  : { placeholder: 'Leitfaden durchsuchen …', zero: 'Keine Treffer für "[SEARCH_TERM]"',
      many: '[COUNT] Treffer für "[SEARCH_TERM]"', one: '1 Treffer für "[SEARCH_TERM]"',
      searching: 'Suche "[SEARCH_TERM]" …' };
const BASE = import.meta.env.BASE_URL;
---
<div class="lf-suche">
  <div id="search"></div>
</div>

<link rel="stylesheet" href={`${BASE}pagefind/pagefind-ui.css`} />
<script type="module" is:inline define:vars={{ BASE, t }}>
  async function init() {
    const el = document.getElementById('search');
    try {
      const mod = await import(/* @vite-ignore */ `${BASE}pagefind/pagefind-ui.js`);
      // pagefind-ui.js ist ein IIFE-Bundle ohne ES-Export: es setzt
      // window.PagefindUI als Seiteneffekt.
      const PagefindUI = window.PagefindUI || mod.PagefindUI || mod.default;
      if (typeof PagefindUI !== 'function') throw new Error('PagefindUI nicht gefunden');
      new PagefindUI({
        element: '#search',
        showImages: false,
        showSubResults: true,
        resetStyles: false,
        translations: {
          placeholder: t.placeholder,
          zero_results: t.zero,
          many_results: t.many,
          one_result: t.one,
          searching: t.searching,
        },
      });
    } catch (e) {
      if (el) el.hidden = true;
    }
  }
  init();
</script>
