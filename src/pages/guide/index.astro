---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Suche from '../../components/Suche.astro';
import { pfad, datei } from '../../lib/pfad';

const abschnitte = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Build guide" lang="en"
      description="The rules an AI should follow when building a small local tool: one self-contained HTML file, no build step, no server."
      schmal={true}>
  <header class="lf-kapitel-kopf">
    <h1>Build guide</h1>
    <p class="lf-kapitel-kopf__kurz">
      What an AI assistant should follow when building a small tool for someone
      who has a browser and nothing else. Written in English on purpose —
      models follow it more reliably. The tools it produces speak the user's
      language.
    </p>
  </header>

  <article class="lf-kapitel">
    <h2>For machines</h2>
    <table>
      <tbody>
        <tr>
          <td><a href={datei('llms.txt')}><code>/leitfaden/llms.txt</code></a></td>
          <td>Index and core rules. The entry point — start here.</td>
        </tr>
        <tr>
          <td><a href={datei('llms-full.txt')}><code>/leitfaden/llms-full.txt</code></a></td>
          <td>Every section in one file. One fetch, no follow-ups.</td>
        </tr>
        <tr>
          <td><code>/leitfaden/guide/&lt;name&gt;.md</code></td>
          <td>A single section as plain text.</td>
        </tr>
      </tbody>
    </table>

    <h2>The one rule that matters most</h2>
    <p>
      Deliver <strong>one self-contained <code>.html</code> file</strong> that
      runs from a double-click. No build step, no server, no install, no ES
      modules. Everything else follows from that.
    </p>

    <h2>Sections</h2>
  </article>

  <Suche lang="en" />

  <div class="lf-grid">
    {abschnitte.map((a) => (
      <a class="lf-karte" href={pfad('guide', a.id)}>
        <span class="lf-karte__titel">{a.data.order}. {a.data.title}</span>
        <p class="lf-karte__kurz">{a.data.read_when}</p>
      </a>
    ))}
  </div>
</Base>
